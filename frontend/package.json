{
  "name": "@ttyglass/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "biome check . && tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "allowBuilds": {
    "esbuild": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}

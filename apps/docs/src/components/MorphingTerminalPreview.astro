---
import logoUrl from '../../../../assets/ttyglass-logo.svg?url';
import TuiScreen from './TuiScreen.astro';
---

<figure class="morphing-terminal-preview">
  <div class="morph-agent-backdrop" data-morph-agent></div>

  <div class="morph-agent-title" data-morph-agent>
    <span>Agent context</span>
  </div>

  <div class="terminal-preview morphing-terminal-frame" data-morph-frame>
    <div class="native-terminal-bar morph-native-bar" data-morph-native>
      <span class="terminal-dots" aria-hidden="true"><i /><i /><i /></span>
      <strong>Terminal - node tests/typescript/main.ts</strong>
    </div>

    <div class="terminal-toolbar morph-browser-bar" data-morph-browser>
      <div class="terminal-identity">
        <img src={logoUrl} alt="" width="24" height="24" />
        <span>
          <small>ttyglass</small>
          <strong>node tests/typescript/main.ts</strong>
        </span>
      </div>
      <span class="terminal-status"><i aria-hidden="true" /> Running <b>PID 8421</b></span>
      <span class="terminal-control">Restart</span>
      <span class="terminal-control">Display</span>
      <span class="terminal-control">Diagnostics</span>
    </div>

    <div class="morph-agent-resource-label" data-morph-agent>Screenshot</div>

    <div class="morph-tui-surface" data-morph-surface>
      <TuiScreen />
    </div>

    <div class="morph-diagnostics" data-morph-diagnostics>
      <div class="diagnostics-preview" aria-hidden="true">
        <div><strong>Diagnostics</strong><span>Clear</span></div>
        <p><time>12:03:18</time> <b>INFO</b> fixture.ready <span>standardLibraryUi: true</span></p>
        <p><time>12:03:19</time> <b>DEBUG</b> viewport.changed <span>size: 104x28</span></p>
      </div>
    </div>
  </div>

  <aside class="morph-agent-data" data-morph-agent>
    <section>
      <small>Status</small>
      <pre>{`{
  "running": true,
  "pid": 8421
}`}</pre>
    </section>
    <section>
      <small>Actions</small>
      <pre>{`[
  { "name": "restart" }
]`}</pre>
    </section>
    <section>
      <small>Viewport</small>
      <pre>{`{ "columns": 104, "rows": 28 }`}</pre>
    </section>
  </aside>

  <section class="morph-agent-stream" data-morph-agent>
    <div class="agent-stream-heading">Diagnostics</div>
    <div class="agent-stream-rows">
      <code data-agent-log>{`{"level":"info","event":"fixture.ready","screen":"orders"}`}</code>
      <code data-agent-log>{`{"level":"debug","event":"viewport.changed","size":"104x28"}`}</code>
      <code data-agent-log>{`{"level":"info","event":"checkout.ready","items":3}`}</code>
    </div>
  </section>

  <figcaption>
    One persistent TUI surface whose surrounding frame changes from a terminal to ttyglass and then
    to agent context.
  </figcaption>
</figure>

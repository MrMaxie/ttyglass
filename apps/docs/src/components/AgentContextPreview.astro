---
import TuiScreen from './TuiScreen.astro';
---

<figure class="agent-context-preview">
  <span class="agent-context-label">Agent context</span>

  <div class="agent-context-grid">
    <section class="agent-screenshot-card">
      <small>Screenshot</small>
      <TuiScreen />
    </section>

    <div class="agent-process-data">
      <section>
        <small>Status</small>
        <pre>{`{
  "running": true,
  "pid": 8421
}`}</pre>
      </section>
      <section>
        <small>Actions</small>
        <pre>{`[
  { "name": "restart" }
]`}</pre>
      </section>
      <section>
        <small>Viewport</small>
        <pre>{`{ "columns": 104, "rows": 28 }`}</pre>
      </section>
    </div>
  </div>

  <section class="agent-diagnostic-stream">
    <div class="agent-stream-heading">Diagnostics</div>
    <div class="agent-stream-rows">
      <code>{`{"level":"info","event":"fixture.ready","screen":"orders"}`}</code>
      <code>{`{"level":"debug","event":"viewport.changed","size":"104x28"}`}</code>
      <code>{`{"level":"info","event":"checkout.ready","items":3}`}</code>
    </div>
  </section>

  <figcaption>
    The agent receives a terminal screenshot, process state, available actions, and application
    diagnostics as data.
  </figcaption>
</figure>
